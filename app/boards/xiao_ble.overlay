/*
 * Device tree overlay for Seeed XIAO BLE nRF52840 + GC9A01 240x240 round display.
 *
 * Wiring (GC9A01 SPI -> nRF52840 / XIAO BLE):
 *   VCC   -> 3V3
 *   GND   -> GND
 *   DIN   -> P0.10 (MOSI / SPI0)
 *   CLK   -> P0.09 (SCK  / SPI0)
 *   CS    -> P0.11 (GPIO output, active low)
 *   DC    -> P0.13 (GPIO output, high=data / low=command)
 *   RST   -> P0.14 (GPIO output, active low)
 *   BL    -> P0.12 (GPIO output, high=backlight on)
 */

#include <dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,display = &gc9a01;
    };
};

&spi0 {
    status = "okay";
    cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;

    gc9a01: display@0 {
        compatible = "solomon,gc9a01";
        reg = <0>;
        spi-max-frequency = <40000000>;
        reset-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
        cmd-data-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        width = <240>;
        height = <240>;
        status = "okay";
    };
};
