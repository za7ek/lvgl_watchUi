source "Kconfig.zephyr"
menu "My Application"
    config ZSWATCH_ROUND_SCREEN
        bool "Enable round screen support for ZSWATCH"
        default y
        help
          Enable round screen display support.

config SEGMENT34_SHOW_LUNAR
    bool "Show Lunar Calendar"
    default y
    help
        Enable lunar calendar display on watchface.

config SEGMENT34_LANGUAGE
    string "Default Language"
    default "zh"
    help
        Default language for the watchface.
        Options: "zh" (Chinese), "en" (English)

config SEGMENT34_THEME
    string "Default Theme"
    default "green"
    help
        Default color theme for the watchface.
        Options: green, blue, red, orange, purple, cyan

config SEGMENT34_ROUND_SCREEN
    bool "Round Screen Support"
    default y
    help
        Enable round screen layout adjustments for 240x240 displays.

endmenu